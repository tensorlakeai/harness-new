FROM tensorlake/ubuntu-minimal
RUN apt-get update && apt-get install -y ca-certificates curl libssl3 && rm -rf /var/lib/apt/lists/*
RUN npm install -g --prefix /usr @openai/codex
RUN mv /usr/bin/codex /usr/bin/codex.real \
 && printf '%s\n' \
    '#!/bin/bash' \
    '# Wrapper: ensure a sane PATH so codex'"'"'s shell tool can find system commands.' \
    'export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}"' \
    'exec /usr/bin/codex.real "$@"' \
    > /usr/bin/codex \
 && chmod +x /usr/bin/codex
RUN printf '%b\n' \
    '\033[38;5;28m╔══════════════════════════════════════════════════════╗\033[0m' \
    '\033[38;5;28m║\033[0m             \033[1;38;5;28mTensorlake Sandbox — Codex\033[0m               \033[38;5;28m║\033[0m' \
    '\033[38;5;28m╚══════════════════════════════════════════════════════╝\033[0m' \
    '' \
    '  Docs: \033[36mhttps://docs.tensorlake.ai/sandboxes/introduction\033[0m' \
    '  Want to add a new agent harness? Checkout: \033[36mhttps://github.com/tensorlakeai/harness-new\033[0m' \
    '' \
    '  To begin run:' \
    '  \033[30;48;5;28m  $ codex  \033[0m' \
    '' \
    > /etc/motd
RUN echo 'cat /etc/motd' >> /etc/bash.bashrc

# Command to create the image in Tensorlake:
# tl sbx image create ./Dockerfile.codex -n codex-harness-new-ui