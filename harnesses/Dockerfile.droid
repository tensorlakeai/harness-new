FROM ubuntu-minimal
RUN apt-get update && apt-get install -y ca-certificates curl libssl3 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://app.factory.ai/cli | sh && cp $HOME/.local/bin/droid /usr/local/bin/droid
RUN printf '╔══════════════════════════════════════════════════════╗\n║             Tensorlake Sandbox — Droid               ║\n╚══════════════════════════════════════════════════════╝\n\n  Docs: https://docs.tensorlake.ai/sandboxes/introduction\n  Want to add a new agent harness? Checkout: https://github.com/tensorlakeai/harness-new\n\n  To begin run:\n  $ droid\n\n' > /etc/motd
RUN echo 'cat /etc/motd' >> /etc/bash.bashrc

# Command to create the image in Tensorlake:
# tl sbx image create ./Dockerfile.droid -n droid-harness-new-ui