FROM tensorlake/ubuntu-minimal
RUN apt-get update && apt-get install -y ca-certificates curl libssl3 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://claude.ai/install.sh | bash && cp $HOME/.local/bin/claude /usr/bin/claude.real
RUN printf '%s\n' \
    '#!/bin/bash' \
    '# Wrapper: ensure a sane PATH so claude'"'"'s Bash tool can find system commands.' \
    'export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}"' \
    'exec /usr/bin/claude.real "$@"' \
    > /usr/bin/claude \
 && chmod +x /usr/bin/claude
RUN printf '%b\n' \
    '\033[38;5;28m╔══════════════════════════════════════════════════════╗\033[0m' \
    '\033[38;5;28m║\033[0m             \033[1;38;5;28mTensorlake Sandbox — Claude\033[0m              \033[38;5;28m║\033[0m' \
    '\033[38;5;28m╚══════════════════════════════════════════════════════╝\033[0m' \
    '' \
    '  Docs: \033[36mhttps://docs.tensorlake.ai/sandboxes/introduction\033[0m' \
    '  Want to add a new agent harness? Checkout: \033[36mhttps://github.com/tensorlakeai/harness-new\033[0m' \
    '' \
    '  To begin run:' \
    '  \033[30;48;5;28m  $ claude  \033[0m' \
    '' \
    > /etc/motd
RUN echo 'cat /etc/motd' >> /etc/bash.bashrc

# Command to create the image in Tensorlake:
# tl sbx image create ./Dockerfile.claude -n claude-harness-new-ui