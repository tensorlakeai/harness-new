FROM tensorlake/ubuntu-minimal
ENV PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Install Claude
RUN apt-get update && apt-get install -y ca-certificates curl libssl3 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://claude.ai/install.sh | bash && cp $HOME/.local/bin/claude /usr/bin/claude.real
RUN printf '%s\n' \
    '#!/bin/bash' \
    '# Wrapper: ensure a sane PATH so claude'"'"'s Bash tool can find system commands.' \
    'export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}"' \
    'exec /usr/bin/claude.real "$@"' \
    > /usr/bin/claude \
 && chmod +x /usr/bin/claude

# Base deps + Chrome runtime helpers
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git gnupg fonts-liberation libssl3 \
 && rm -rf /var/lib/apt/lists/*

# Google Chrome (provides CDP / --remote-debugging-port for browser-harness to attach to)
RUN curl -fsSL https://dl.google.com/linux/linux_signing_key.pub \
      | gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg \
 && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] http://dl.google.com/linux/chrome/deb/ stable main" \
      > /etc/apt/sources.list.d/google-chrome.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends google-chrome-stable \
 && rm -rf /var/lib/apt/lists/*

# uv (Python project / tool manager) on PATH
RUN curl -fsSL https://astral.sh/uv/install.sh | env HOME=/root sh \
 && cp /root/.local/bin/uv /usr/bin/uv \
 && cp /root/.local/bin/uvx /usr/bin/uvx

# Clone browser-harness and install it as a global editable uv tool.
# Everything is kept under /opt so the runtime tl-user can read it.
RUN git clone https://github.com/browser-use/browser-harness /opt/browser-harness \
 && mkdir -p /opt/uv-data \
 && cd /opt/browser-harness \
 && HOME=/opt/uv-data UV_TOOL_BIN_DIR=/usr/bin uv tool install -e . \
 && chmod -R o+rX /opt/browser-harness /opt/uv-data

# Wrapper: sane PATH for child shells, plus auto-start headless Chrome with CDP
# on :9222 before invoking the real browser-harness CLI.
RUN mv /usr/bin/browser-harness /usr/bin/browser-harness.real \
 && printf '%s\n' \
    '#!/bin/bash' \
    'export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}"' \
    '# Auto-start headless Chrome with CDP if nothing is listening on :9222.' \
    'if ! curl -s -m 2 -o /dev/null http://localhost:9222/; then' \
    '  mkdir -p "$HOME/.cache/chrome-profile"' \
    '  google-chrome --headless=new --no-sandbox --disable-gpu \' \
    '                --remote-debugging-port=9222 \' \
    '                --user-data-dir="$HOME/.cache/chrome-profile" \' \
    '                >/tmp/chrome.log 2>&1 &' \
    '  for _ in $(seq 1 30); do' \
    '    curl -s -m 2 -o /dev/null http://localhost:9222/ && break' \
    '    sleep 1' \
    '  done' \
    'fi' \
    'exec /usr/bin/browser-harness.real "$@"' \
    > /usr/bin/browser-harness \
 && chmod +x /usr/bin/browser-harness

RUN printf '%b\n' \
    '\033[38;5;28m╔══════════════════════════════════════════════════════╗\033[0m' \
    '\033[38;5;28m║\033[0m        \033[1;38;5;28mTensorlake Sandbox — Browser Harness\033[0m          \033[38;5;28m║\033[0m' \
    '\033[38;5;28m╚══════════════════════════════════════════════════════╝\033[0m' \
    '' \
    '  Docs: \033[36mhttps://docs.tensorlake.ai/sandboxes/introduction\033[0m' \
    '  Want to add a new agent harness? Checkout: \033[36mhttps://github.com/tensorlakeai/harness-new\033[0m' \
    '' \
    '  Headless Chrome (CDP on :9222) auto-starts on first invocation.' \
    '  Source: /opt/browser-harness  (editable install via uv)' \
    '' \
    '  To begin:' \
    '    1. \033[1;38;5;28mbrowser-harness --setup\033[0m' \
    '    2. \033[1;38;5;28mclaude --dangerously-skip-permissions\033[0m' \
    '    3. Login to Claude' \
    '    4. Tell Claude to: \033[1;38;5;28muse /opt/browser-harness/SKILL.md\033[0m' \
    '' \
    > /etc/motd
RUN echo 'cat /etc/motd' >> /etc/bash.bashrc

# Command to create the image in Tensorlake:
# tl sbx image create ./Dockerfile.browser -n browser-harness-new-ui
